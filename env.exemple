# Base de données PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=master
DB_USER=postgres
DB_PASSWORD=postgres


# Variables souvent utilisées par Docker/Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=master


# API Kaggle
# Nécessaire pour télécharger les datasets initiaux
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_token

# Taille de la fenêtre de contexte (K derniers films vus)
MDP_K=3
MDP_FRACTION=1.0
MDP_MAX_SKIP=5
MDP_BATCH_SIZE=10000


# Hyperparamètres Reinforcement Learning (MDP Solver)
MDP_GAMMA_BOOST=0.001
MDP_GAMMA_RL=0.9
MDP_LIST_SIZE=3
MDP_THRESHOLD=0.001
MDP_TEMPERATURE=1.0

# Cors
CORS_ORIGINS=http://localhost:5173,http://localhost:3000